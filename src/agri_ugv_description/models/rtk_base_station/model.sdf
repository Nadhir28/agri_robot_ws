<?xml version="1.0"?>
<!-- RTK GNSS base station (surveying tripod, 1.6 m antenna, radio link).
     Placed on a point with known coordinates. Its receiver measures the same
     satellite errors as the robot; agri_ugv rtk_gnss.py turns that into corrections. -->
<sdf version="1.9">
  <model name="rtk_base_station">
    <static>true</static>
    <link name="link">
      <collision name="footprint">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry><cylinder><radius>0.55</radius><length>1.6</length></cylinder></geometry>
      </collision>
      <visual name="leg_0">
        <pose>0.2750 0.0000 0.75 0 -0.3514 0.0000</pose>
        <geometry><cylinder><radius>0.018</radius><length>1.5977</length></cylinder></geometry>
        <material><ambient>0.75 0.55 0.2 1</ambient><diffuse>0.85 0.62 0.25 1</diffuse></material>
      </visual>
      <visual name="leg_1">
        <pose>-0.1375 0.2382 0.75 0 -0.3514 2.0944</pose>
        <geometry><cylinder><radius>0.018</radius><length>1.5977</length></cylinder></geometry>
        <material><ambient>0.75 0.55 0.2 1</ambient><diffuse>0.85 0.62 0.25 1</diffuse></material>
      </visual>
      <visual name="leg_2">
        <pose>-0.1375 -0.2382 0.75 0 -0.3514 4.1888</pose>
        <geometry><cylinder><radius>0.018</radius><length>1.5977</length></cylinder></geometry>
        <material><ambient>0.75 0.55 0.2 1</ambient><diffuse>0.85 0.62 0.25 1</diffuse></material>
      </visual>
      <visual name="mast">
        <pose>0 0 1.55 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="antenna">
        <pose>0 0 1.62 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
      </visual>
      <visual name="radio">
        <pose>0 0 1.05 0 0 0</pose>
        <geometry><box><size>0.18 0.12 0.22</size></box></geometry>
        <material><ambient>0.1 0.25 0.6 1</ambient><diffuse>0.15 0.35 0.8 1</diffuse></material>
      </visual>
      <visual name="radio_whip">
        <pose>0.06 0 1.36 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.4</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <!-- GNSS receiver at the antenna phase centre. Receiver noise only (~1 cm);
           the common satellite/atmosphere error is added by rtk_gnss.py. -->
      <sensor name="base_gnss" type="navsat">
        <pose>0 0 1.645 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>rtk_base/navsat</topic>
        <gz_frame_id>rtk_base_antenna</gz_frame_id>
        <navsat>
          <position_sensing>
            <horizontal><noise type="gaussian"><mean>0.0</mean><stddev>8.983e-08</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></vertical>
          </position_sensing>
        </navsat>
      </sensor>
    </link>
  </model>
</sdf>
