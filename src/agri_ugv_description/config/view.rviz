Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
      Keep: 1
      Shape:
        Value: Arrow
        Shaft Length: 0.5
        Shaft Radius: 0.03
        Head Length: 0.15
        Head Radius: 0.08
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.15
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR 3D
      Enabled: true
      Topic:
        Value: /points
        Reliability Policy: Best Effort
      Size (m): 0.04
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/Image
      Name: Depth
      Enabled: true
      Topic:
        Value: /camera/depth/image_raw
        Reliability Policy: Reliable
      # fixed 0-10 m scale: auto-normalize breaks on inf pixels (sky) and shows noise
      Normalize Range: false
      Min Value: 0
      Max Value: 10
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: odom
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      # the view follows the robot (Fixed Frame stays odom)
      Target Frame: base_footprint
      Distance: 6
      Focal Point: {X: 0, Y: 0, Z: 0.2}
      Pitch: 0.5
      Yaw: 0.8
