<?xml version="1.0"?>
<!--
  
  [D] = dimension printed on the reference drawing 
  [E] = estimated by pixel measurement against the printed dimensions
  [A] = assumption (not visible in the references)
-->
<robot name="agri_ugv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Parameters ===================== -->
  <!-- Overall envelope -->
  <xacro:property name="overall_length"   value="0.990"/>  <!-- [D] 990 mm -->
  <xacro:property name="overall_width"    value="0.698"/>  <!-- [D] 698 mm -->
  <xacro:property name="overall_height"   value="0.381"/>  <!-- [D] 381 mm, ground to top plate -->
  <xacro:property name="ground_clearance" value="0.139"/>  <!-- [D] 139 mm -->
  <xacro:property name="bumper_height"    value="0.160"/>  <!-- [D] 160 mm, ground to bumper underside -->

  <!-- Chassis -->
  <xacro:property name="plate_length"  value="0.740"/>  <!-- [D] 740 mm top plate -->
  <xacro:property name="body_width"    value="0.420"/>  <!-- [D] 420 mm -->
  <xacro:property name="body_length"   value="0.700"/>  <!-- [E] -->
  <xacro:property name="plate_thick"   value="0.020"/>  <!-- [A] -->
  <xacro:property name="body_bottom"   value="${ground_clearance}"/>
  <xacro:property name="body_top"      value="${overall_height - plate_thick}"/>
  <xacro:property name="body_height"   value="${body_top - body_bottom}"/>

  <!-- Wheels -->
  <xacro:property name="wheel_radius" value="0.165"/>  <!-- [E] -->
  <xacro:property name="wheel_width"  value="0.114"/>  <!-- [E] -->
  <xacro:property name="wheelbase"    value="0.512"/>  <!-- [E] axle to axle -->
  <xacro:property name="track"        value="0.585"/>  <!-- [E] wheel centre to wheel centre -->

  <!-- Bumpers -->
  <xacro:property name="bumper_tube" value="0.032"/>   <!-- [A] tube diameter -->

  <!-- Masses: total 80 kg [D] -->
  <xacro:property name="wheel_mass"   value="2.6"/>    <!-- [A] -->
  <xacro:property name="bumper_mass"  value="0.8"/>    <!-- [A] -->
  <xacro:property name="spring_link_mass" value="0.3"/>  <!-- [A -->
  <xacro:property name="chassis_mass" value="${80.0 - 4*wheel_mass - 2*bumper_mass - 4*spring_link_mass}"/>

  <!-- Tyre compliance [A]: ~7 mm static deflection, typical of a small pneumatic tyre -->
  <xacro:property name="tyre_stiffness" value="25000.0"/>  <!-- N/m per wheel -->
  <xacro:property name="tyre_damping"   value="600.0"/>    <!-- N*s/m per wheel -->
  <xacro:property name="tyre_travel"    value="0.025"/>    <!-- m, +- -->
  <!-- spring rest offset so the static load leaves the joint at 0 (ride height unchanged) -->
  <xacro:property name="sprung_mass"    value="${80.0 - 4*(wheel_mass + spring_link_mass)}"/>
  <xacro:property name="tyre_preload_offset" value="${-sprung_mass*9.81/4/tyre_stiffness}"/>

  <!-- Drive limits -->
  <xacro:property name="wheel_effort"   value="100.0"/>  <!-- [A] N*m per wheel -->
  <xacro:property name="wheel_velocity" value="15.0"/>   <!-- [A] rad/s (> 2.0 m/s / r) -->

  <!-- base_link sits at axle height; base_footprint on the ground -->
  <xacro:property name="axle_z" value="${wheel_radius}"/>

  <!-- ===================== Materials ===================== -->
  <material name="husky_yellow"><color rgba="0.98 0.78 0.05 1.0"/></material>
  <material name="dark_grey"><color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="tyre_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="hub_grey"><color rgba="0.45 0.45 0.45 1.0"/></material>
  <material name="estop_red"><color rgba="0.85 0.05 0.05 1.0"/></material>

  <!-- ===================== Inertia macros ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12.0}" iyz="0"
             izz="${m*(x*x+y*y)/12.0}"/>
  </xacro:macro>

  <!-- Cylinder whose axis is the link Y axis -->
  <xacro:macro name="wheel_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0" ixz="0"
             iyy="${m*r*r/2.0}" iyz="0"
             izz="${m*(3*r*r+h*h)/12.0}"/>
  </xacro:macro>

  <!-- ===================== Links ===================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${axle_z}" rpy="0 0 0"/>
  </joint>

  <!-- Chassis body + top plate. Origin at axle height, centre of wheelbase. -->
  <link name="base_link">
    <!-- yellow body -->
    <visual>
      <origin xyz="0 0 ${(body_bottom + body_top)/2 - axle_z}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="husky_yellow"/>
    </visual>
    <!-- black top plate -->
    <visual>
      <origin xyz="0 0 ${body_top + plate_thick/2 - axle_z}"/>
      <geometry><box size="${plate_length} ${body_width + 0.02} ${plate_thick}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- E-stop on the front face -->
    <visual>
      <origin xyz="${body_length/2 + 0.005} ${-body_width/4} ${(body_bottom + body_top)/2 - axle_z + 0.03}" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="0.025" length="0.02"/></geometry>
      <material name="estop_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${(body_bottom + overall_height)/2 - axle_z}"/>
      <geometry><box size="${body_length} ${body_width} ${overall_height - body_bottom}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${(body_bottom + overall_height)/2 - axle_z}"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia m="${chassis_mass}" x="${body_length}" y="${body_width}"
                         z="${overall_height - body_bottom}"/>
    </inertial>
  </link>

  <!-- Bumper bar: front (dir=1) / rear (dir=-1). Extends to overall_length. -->
  <xacro:macro name="bumper" params="name dir">
    <xacro:property name="bar_x" value="${overall_length/2 - bumper_tube/2}"/>
    <xacro:property name="arm_len" value="${bar_x - body_length/2}"/>
    <link name="${name}_bumper">
      <!-- cross bar -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${bumper_tube/2}" length="${body_width}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <!-- side arms back to the chassis -->
      <visual>
        <origin xyz="${-dir*arm_len/2} ${body_width/2 - bumper_tube/2} 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${bumper_tube/2}" length="${arm_len}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <visual>
        <origin xyz="${-dir*arm_len/2} ${-body_width/2 + bumper_tube/2} 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${bumper_tube/2}" length="${arm_len}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="${-dir*arm_len/2} 0 0"/>
        <geometry><box size="${arm_len + bumper_tube} ${body_width} ${bumper_tube}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${-dir*arm_len/2} 0 0"/>
        <mass value="${bumper_mass}"/>
        <xacro:box_inertia m="${bumper_mass}" x="${arm_len}" y="${body_width}" z="${bumper_tube}"/>
      </inertial>
    </link>
    <joint name="${name}_bumper_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_bumper"/>
      <origin xyz="${dir*bar_x} 0 ${bumper_height + bumper_tube/2 - axle_z}"/>
    </joint>
  </xacro:macro>

  <xacro:bumper name="front" dir="1"/>
  <xacro:bumper name="rear"  dir="-1"/>

  <!-- Wheel: continuous joint about +Y so positive velocity drives the robot forward -->
  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tyre_black"/>
      </visual>
      <!-- hub, slightly proud of the tyre on the outer side -->
      <visual>
        <origin xyz="0 ${math.copysign(wheel_width/2, y)} 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius*0.5}" length="0.01"/></geometry>
        <material name="hub_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
    
    <link name="${prefix}_tyre_spring">
      <inertial>
        <mass value="${spring_link_mass}"/>
        <xacro:box_inertia m="${spring_link_mass}" x="0.05" y="0.05" z="0.05"/>
      </inertial>
    </link>
    <joint name="${prefix}_tyre_spring_joint" type="prismatic">
      <parent link="base_link"/>
      <child link="${prefix}_tyre_spring"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-tyre_travel}" upper="${tyre_travel}" effort="5000" velocity="2.0"/>
      <dynamics damping="${tyre_damping}"/>
    </joint>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_tyre_spring"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="${wheel_effort}" velocity="${wheel_velocity}"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x="${ wheelbase/2}" y="${ track/2}"/>
  <xacro:wheel prefix="front_right" x="${ wheelbase/2}" y="${-track/2}"/>
  <xacro:wheel prefix="rear_left"   x="${-wheelbase/2}" y="${ track/2}"/>
  <xacro:wheel prefix="rear_right"  x="${-wheelbase/2}" y="${-track/2}"/>

  <xacro:include filename="$(find agri_ugv_description)/urdf/agri_ugv.gazebo.xacro"/>
  <xacro:include filename="$(find agri_ugv_description)/urdf/agri_ugv.sensors.xacro"/>

</robot>


